<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="fullscreen_player_text_primary">#FFFFFF</color>
    <color name="fullscreen_player_bubble_text">#2B2B2B</color>
    <color name="fullscreen_player_progress_elapsed">#141414</color>
    <color name="fullscreen_player_progress_remaining">#A6787878</color>

    <dimen name="fullscreen_transcript_text_size">36sp</dimen>
    <dimen name="fullscreen_cover_corner_radius">14dp</dimen>

    <style name="FullscreenPlayerText">
        <item name="android:fontFamily">@font/haffer_regular</item>
        <item name="fontFamily">@font/haffer_regular</item>
        <item name="android:textColor">@color/fullscreen_player_text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="FullscreenPlayerText.Title">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="FullscreenPlayerText.Subtitle">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="FullscreenPlayerTime">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/fullscreen_player_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textDirection">ltr</item>
    </style>
</resources>
